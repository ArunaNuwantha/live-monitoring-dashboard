# Copy to .env.local and adjust. Everything prefixed VITE_ is PUBLIC (bundled into the client):
# never put secrets, API keys or tokens here.

# "simulated" (default, no backend needed) or "websocket"
VITE_STREAM_MODE=simulated

# Simulated feed: average events per second (1–20000)
VITE_SIM_RATE=200

# WebSocket feed: must be wss:// (ws:// is accepted for localhost only)
# VITE_STREAM_MODE=websocket
# VITE_STREAM_URL=ws://localhost:8787

# Optional same-origin endpoint that returns {"token": "..."} for the session (httpOnly cookie auth).
# The token is sent as the first socket frame, held in memory only, never in the URL.
# VITE_STREAM_TOKEN_URL=/api/stream-token

# Dev diagnostics (fixed event codes only; never payloads or tokens)
VITE_DEBUG=false
